@startuml
'https://plantuml.com/class-diagram

skinparam classAttributeIconSize 0

class GreenTrackerException
{
+ GreenTrackerException(message: String)
}

Exception <|-- GreenTrackerException

interface Comparable<Verbrauch>
{
+ {abstract} compareTo(o: Verbrauch): int
}

Comparable <|.. Verbrauch

abstract class Verbrauch
{
- taetigkeit: String
- dauer: double
- anzahlTaetigkeit: int
+ Verbrauch()
+ Verbrauch(taetigkeit: String, dauer: double, anzahlTaetigkeit: int)
+ getTaetigkeit(): String
+ getDauer(): double
+ getAnzahlTaetigkeit(): int
+ setTaetigkeit(taetigkeit: String): void
+ setDauer(dauer: double): void
+ setAnzahlTaetigkeit(anzahlTaetigkeit: int): void
+ {abstract} preis(): double
+ {abstract} ausstoß(): double
+ toString(): String
+ {abstract} toCSVString(): String
+ compareTo(o: Verbrauch): int
+ equals(o: Object): boolean
+ hashCode(): int
}

class Wasserverbrauch extends Verbrauch
{
- aktuellerWasserPreis: double
- kubikmeternVerbrauchWasser: double
+ Wasserverbrauch(taetigkeit: String, dauer: double, anzahlTaetigkeit: int, aktuellerWasserPreis: double, kubikmeternVerbrauchWasser: double)
+ getAktuellerWasserPreis(): double
+ getKubikmeternVerbrauchWasser(): double
+ preis(): double
+ ausstoß(): double
+ setAktuellerWasserPreis(aktuellerWasserPreis: double): void
+ setKubikmeternVerbrauchWasser(kubikmeternVerbrauchWasser: double): void
+ toString(): String
+ toCSVString(): String
+ equals(o: Object): boolean
+ hashCode(): int
}

class GasVerbrauch extends Verbrauch
{
- aktuellerGasPreis: double
- kubikmeternVerbrauchGas: double
+ GasVerbrauch(taetigkeit: String, dauer: double, anzahlTaetigkeit: int, aktuellerGasPreis: double, kubikmeternVerbrauchGas: double)
+ getAktuellerGasPreis(): double
+ getKubikmeternVerbrauchGas(): double
+ preis(): double
+ ausstoß(): double
+ setAktuellerGasPreis(aktuellerGasPreis: double): void
+ setKubikmeternVerbrauchGas(kubikmeternVerbrauchGas: double): void
+ toString(): String
+ toCSVString(): String
+ equals(o: Object): boolean
+ hashCode(): int
}

class StromVerbrauch extends Verbrauch
{
- aktuellerStromPreis: double
- kilowattstunden: double
+ StromVerbrauch(taetigkeit: String, dauer: double, anzahlTaetigkeit: int, aktuellerStromPreis: double, kilowattstunden: double)
+ getAktuellerStromPreis(): double
+ getKilowattstunden(): double
+ preis(): double
+ ausstoß(): double
+ setAktuellerStromPreis(aktuellerStromPreis: double): void
+ setKilowattstunden(kilowattstunden: double): void
+ toString(): String
+ toCSVString(): String
+ equals(o: Object): boolean
+ hashCode(): int
}

class Duschverbrauch extends Wasserverbrauch
{
- zugeordneterGasVerbrauch: GasVerbrauch
+ Duschverbrauch(taetigkeit: String, dauer: double, anzahlTaetigkeit: int, aktuellerWasserPreis: double, kubikmeternVerbrauchWasser: double, zugeordneterGasVerbrauch: GasVerbrauch)
+ getZugeordneterGasVerbrauch(): GasVerbrauch
+ setZugeordneterGasVerbrauch(zugeordneterGasVerbrauch: GasVerbrauch): void
+ preis(): double
+ ausstoß(): double
+ toString(): String
+ toCSVString(): String
+ equals(o: Object): boolean
+ hashCode(): int
}

class GreenTracker
{
- name: String
- verbrauche: List<Verbrauch>
+ GreenTracker(name: String)
+ getVerbrauch(index: int): Verbrauch
+ hinzufuegen(verbrauch: Verbrauch): boolean
+ entfernen(verbrauch: Verbrauch): boolean
+ entfernen(bezeichnung: String): int
+ berechneGesamtEmisson(): double
+ berechneVerbrauchEmisson(): double
+ berechneGesamtPreis(): double
+ berechneVerbrauchPreis(): double
+ writeVerbraucheToCSV(): void
+ save(): void
+ readVerbraucheFromCSV(): void
+ sortieren(): void
+ sortierenNachBezeichnung(): void
+ toString(): String
+ toCSVString(): String
}

GreenTracker --> Verbrauch
Duschverbrauch --> GasVerbrauch

together {
class Verbrauch
class GreenTracker
}
GreenTracker -[hidden] Verbrauch

together {
class GreenTracker
class GreenTrackerException
}
GreenTrackerException -[hidden] Tracker

@enduml
